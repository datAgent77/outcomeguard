# Copy to .env (git-ignored) and fill in. Never commit real values.
# ---- API ----------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://localhost/outcomeguard

# sandbox  = real calls to the PayPal Sandbox (needs the two credentials below)
# rehearsal = no PayPal calls at all; every result is labeled SIMULATED
PAYMENT_MODE=sandbox

# PayPal Developer Dashboard → Apps & Credentials → Sandbox → your app.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Dashboard → your app → Webhooks (needs a public HTTPS URL, e.g. the Render deploy).
PAYPAL_WEBHOOK_ID=

# Where PayPal returns the buyer after approval (UX only; never trusted as proof).
PUBLIC_API_URL=http://localhost:8000
WEB_URL=http://localhost:3000

# Developer-only P02 endpoints under /dev/payments. Generate a token with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ENABLE_SANDBOX_PROOF=false
OPERATOR_TOKEN=

# (Legacy, unused since P06: sessions are server-side; kept so old .env files load.)
SESSION_SECRET=

# ---- Verification (P04) -------------------------------------------------
# Signs per-run form-sink tokens (API and verifier must share it).
SINK_SECRET=
# Where the verifier's browser reaches the API's /sinks/* endpoint.
SINK_BASE_URL=http://127.0.0.1:8010
VERIFIER_FORM_SINKS=default
# DEVELOPMENT ONLY: exact ip:port pairs the egress proxy may reach although private
# (local fixtures on 8020, API sink on 8010, test collector on 8030). Refused in production.
# For the local demo (scripts/demo/start.sh): 127.0.0.1:8020,127.0.0.1:8010
VERIFIER_DEV_ALLOW=
# Container mode: external egress proxy and isolated runner job server.
# VERIFIER_PROXY_URL=http://proxy:3128
# VERIFIER_RUNNER_URL=http://runner:7000

# ---- AI (P05) ------------------------------------------------------------
# Claude API key (console.anthropic.com → API keys). Only the API reads it; the
# verification worker and runner refuse to start if any ANTHROPIC_* variable is present.
ANTHROPIC_API_KEY=
# claude-sonnet-5-5 (default) · claude-sonnet-5 · claude-opus-5 (comparison)
AI_MODEL=claude-sonnet-5-5
AI_EFFORT=high
AI_TIMEOUT_SECONDS=120
AI_MAX_OUTPUT_TOKENS=12000
AI_MAX_RETRIES=1
# Keep false for reproducible proofs (the requested model is the model that answers).
AI_SERVER_FALLBACK=false
# Local ESTIMATED limits per UTC day — not billing. Also set a spend limit in the Console.
AI_DAILY_BUDGET_USD=5.00
AI_DAILY_TOKEN_BUDGET=1000000

LOG_LEVEL=INFO
# ---- Web ----------------------------------------------------------------
OUTCOMEGUARD_API_URL=http://localhost:8000

# ---- Local demo (scripts/demo, apps/api/scripts/prepare_demo.py) ---------------
# Password you choose for the seeded demo accounts (alice/bob/rita/maya/eve). Never commit it.
DEMO_PASSWORD=
