# Copy to .env (git-ignored) and fill in. Never commit real values.
# ---- API ----------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://localhost/outcomeguard

# sandbox  = real calls to the PayPal Sandbox (needs the two credentials below)
# rehearsal = no PayPal calls at all; every result is labeled SIMULATED
PAYMENT_MODE=sandbox

# PayPal Developer Dashboard → Apps & Credentials → Sandbox → your app.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Dashboard → your app → Webhooks (needs a public HTTPS URL, e.g. the Render deploy).
PAYPAL_WEBHOOK_ID=

# Where PayPal returns the buyer after approval (UX only; never trusted as proof).
PUBLIC_API_URL=http://localhost:8000
WEB_URL=http://localhost:3000

# Developer-only P02 endpoints under /dev/payments. Generate a token with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ENABLE_SANDBOX_PROOF=false
OPERATOR_TOKEN=

LOG_LEVEL=INFO
# ---- Web ----------------------------------------------------------------
OUTCOMEGUARD_API_URL=http://localhost:8000
