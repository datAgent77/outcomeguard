# Verification runner / egress proxy image: Python 3.12 + Playwright Chromium + Node 22 +
# pinned Lighthouse. Contains no credentials; never give it PAYPAL_*, DATABASE_URL or
# SESSION_SECRET (the runner refuses to start if it sees them).
FROM node:22-bookworm-slim AS node

FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm
COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project
COPY src ./src
RUN uv sync --frozen --no-dev \
 && uv run --no-sync playwright install --with-deps chromium \
 && rm -rf /var/lib/apt/lists/*
COPY verifier-tools/package.json verifier-tools/package-lock.json ./verifier-tools/
RUN cd verifier-tools && npm ci --omit=dev
RUN useradd --uid 10001 --create-home runner
USER runner
# No user namespaces in a default container → Chromium's own sandbox cannot start. The
# container (non-root, internal network whose only peer is the egress proxy) is the
# isolation boundary here; on hosts the runner keeps Chromium's sandbox on.
ENV PATH="/app/.venv/bin:$PATH" VERIFIER_CHROMIUM_SANDBOX=0
CMD ["python", "-m", "outcomeguard.verification.runner", "--serve", "0.0.0.0:7000"]
